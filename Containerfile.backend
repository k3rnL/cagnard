# syntax=docker/dockerfile:1

FROM golang:1.25-bookworm AS build

WORKDIR /workspace

COPY backend-go/go.mod backend-go/go.sum ./backend-go/

WORKDIR /workspace/backend-go

RUN go mod download

COPY backend-go ./

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/cagnard-backend \
    ./cmd/cagnard-backend

FROM gcr.io/distroless/static-debian12:nonroot AS runtime

LABEL org.opencontainers.image.title="Cagnard backend" \
      org.opencontainers.image.description="Backend for the Cagnard self-hosted storage browser" \
      org.opencontainers.image.source="https://github.com/k3rnL/cagnard" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

WORKDIR /opt/cagnard

COPY --from=build --chown=nonroot:nonroot /out/cagnard-backend ./cagnard-backend
COPY --chown=nonroot:nonroot config ./config
COPY --chown=nonroot:nonroot examples ./examples
COPY --chown=nonroot:nonroot LICENSE /usr/share/licenses/cagnard/LICENSE

ENV CAGNARD_CONFIG=/opt/cagnard/config/cagnard.example.conf

EXPOSE 8080

USER nonroot:nonroot

ENTRYPOINT ["/opt/cagnard/cagnard-backend"]
