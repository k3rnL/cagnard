{
  "name": "cagnard",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hosted storage browser for Unix filesystems and S3-compatible object storage.",
  "homepage": "https://k3rnl.github.io/cagnard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3rnL/cagnard.git"
  },
  "keywords": [
    "self-hosted",
    "file-browser",
    "s3",
    "object-storage",
    "minio",
    "docker",
    "kubernetes",
    "helm"
  ],
  "scripts": {
    "backend:test": "cd backend-go && go test ./...",
    "backend:go:test": "cd backend-go && go test ./...",
    "frontend:test": "pnpm --filter @cagnard/frontend test",
    "frontend:check": "pnpm --filter @cagnard/frontend typecheck",
    "frontend:build": "pnpm --filter @cagnard/frontend build",
    "examples:compose:check": "bash scripts/validate-compose-examples.sh",
    "examples:helm:check": "bash scripts/validate-helm-examples.sh",
    "examples:check": "pnpm examples:compose:check && pnpm examples:helm:check",
    "docs:check": "node scripts/validate-docs.mjs",
    "demo:check": "node scripts/check-demo.mjs",
    "check": "pnpm backend:test && pnpm frontend:test && pnpm frontend:check && pnpm frontend:build && pnpm examples:check && pnpm demo:check && pnpm docs:check"
  },
  "packageManager": "pnpm@11.7.0"
}
